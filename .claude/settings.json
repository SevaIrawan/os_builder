{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/nosm-session-start.sh\"; [ -f \"$S\" ] && bash \"$S\" || true",
            "timeout": 10,
            "statusMessage": "NOSM: pointer"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__Atlassian_Rovo.*|mcp__n8n__.*",
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/nosm-gate.sh\"; [ -f \"$S\" ] && bash \"$S\" || true",
            "timeout": 10,
            "statusMessage": "NOSM gate"
          }
        ]
      }
    ]
  }
}
